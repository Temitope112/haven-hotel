{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,
    "skipLibCheck": true,

    "sourceMap": true,

    "types": [
      "node"
    ],
    "resolveJsonModule": true
  },

  "include": [
  "src/**/*.ts",
  "src/**/*.d.ts"
]
}